PORT=5000
CLIENT_URL=https://your-frontend-app.vercel.app

# Database Connection (Render/Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Or individual DB fields if self-hosting:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=trust_account_db

# Free SMTP Configuration (e.g. Gmail 16-letter App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
